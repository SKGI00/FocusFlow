subgraph cluster_logic {label="Presentation and configuration";style="rounded,dashed";color="#B9D4C5";SP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>SessionPresenter : ChangeNotifier</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ durationMinutes: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ remaining: Duration</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ status: SessionStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ distractionCount: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ start(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ pause(): void; resume(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ complete(): void; reset(): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ logDistraction(tag: String): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ savedSessionId(): Future&lt;int?&gt;</FONT></TD></TR></TABLE>>];RP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>ReflectionPresenter : ChangeNotifier</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ sessionId: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ rating: int?</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ tags: Set&lt;String&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ selectFeeling(value: int): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ toggleTag(value: String): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ save(): Future&lt;bool&gt;</FONT></TD></TR></TABLE>>];SET [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>FocusSettingsRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ instance: FocusSettingsRepository</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ load(): Future&lt;FocusSettings&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ save(value: FocusSettings): Future&lt;void&gt;</FONT></TD></TR></TABLE>>];SCH [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>ReminderScheduler (abstract)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ requestPermission(): Future&lt;bool&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ scheduleDaily(minutes: int): Future&lt;void&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ cancel(): Future&lt;void&gt;</FONT></TD></TR></TABLE>>];SYS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>SystemReminderScheduler</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ isScheduled(): Future&lt;bool&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ sendTestNotification(): Future&lt;void&gt;</FONT></TD></TR></TABLE>>];}
subgraph cluster_data {label="Domain models and SQLite repositories";style="rounded,dashed";color="#DEC7B1";APP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#FFF4E5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>AppServices</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ helper: DatabaseHelper</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ sessions: SessionRepository</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ distractions: DistractionRepository</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ reflections: ReflectionRepository</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ create(databasePath: String?): AppServices</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ dispose(): Future&lt;void&gt;</FONT></TD></TR></TABLE>>];SR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#FFF4E5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>SessionRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ insert(session: Session): Future&lt;int&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ update(session: Session): Future&lt;void&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ all(): Future&lt;List&lt;Session&gt;&gt;</FONT></TD></TR></TABLE>>];DR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#FFF4E5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>DistractionRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ insert(event: DistractionEvent): Future&lt;int&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN=