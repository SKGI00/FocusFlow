CELLPADDING="7"><FONT POINT-SIZE="10">+ toMap(): Map&lt;String, Object?&gt;</FONT></TD></TR></TABLE>>];DE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>DistractionEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ sessionId: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ timestamp: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ tag: String?</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ toMap(): Map&lt;String, Object?&gt;</FONT></TD></TR></TABLE>>];REF [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#8BA29E" BGCOLOR="#F4F8F5"><TR><TD BGCOLOR="#D6E7E4" CELLPADDING="8"><B>Reflection</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ sessionId: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ timestamp: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ rating: int?</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ note: String?</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="10">+ toMap(): Map&lt;String, Object?&gt;</FONT></TD></TR></TABLE>>];}
